# Model endpoints. Any OpenAI-compatible API works: DeepSeek, OpenAI, OpenRouter, a LiteLLM proxy,
# Ollama (http://localhost:11434/v1), vLLM, and others.

# One endpoint for every role:
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-...
ANSWER_MODEL=deepseek-flash
JUDGE_MODEL=deepseek-v4-pro        # use a different model from ANSWER_MODEL if you can

# The vision pass needs a model that accepts images. In a test, deepseek-flash accepted them, so
# VISION_MODEL=deepseek-flash works with the lines above. To use another provider for vision instead,
# set these three lines. Without VISION_BASE_URL and VISION_API_KEY, vision uses LLM_BASE_URL and LLM_API_KEY.
# VISION_BASE_URL=https://api.openai.com/v1
# VISION_API_KEY=sk-...
VISION_MODEL=deepseek-flash

# Any role can have its own endpoint: ANSWER_BASE_URL / ANSWER_API_KEY, JUDGE_BASE_URL / JUDGE_API_KEY.
# The old names LITELLM_URL and LITELLM_KEY still work as a fallback for LLM_BASE_URL and LLM_API_KEY.

# Optional
# ANSWER_MODELS=deepseek-flash,deepseek-v4-pro   # models the UI offers, if the provider has no /models list
# API_KEY=change-me        # required header X-API-Key (REST) / x-api-key metadata (gRPC); needed when HOST is not local
# PRICE_IN=0               # USD per million tokens, for costs.py
# PRICE_OUT=0
# PRICE_VISION_IN=0
# PRICE_VISION_OUT=0
# DATABASE_URL=postgresql://docintel:docintel@localhost:5432/docintel   # turns on conversation history (docker compose up -d postgres)
